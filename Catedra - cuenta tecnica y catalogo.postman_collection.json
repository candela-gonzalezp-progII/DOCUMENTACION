{
	"info": {
		"_postman_id": "1be5f125-105e-40c9-8d30-ab54d0a2920e",
		"name": "Catedra - cuenta tecnica y catalogo",
		"description": "Cuenta tecnica de integracion con la catedra. NO contiene secretos: usar un Environment de Postman con las variables baseUrl, login, password, groupId, token. No exportar ni subir el Environment.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "43585477",
		"_collection_link": "https://candelagonzalez.postman.co/workspace/Candela-Gonzalez's-Workspace~6e2b16f0-a35a-4c25-8fff-1ab9792ccc43/collection/43585477-1be5f125-105e-40c9-8d30-ab54d0a2920e?action=share&source=collection_link&creator=43585477"
	},
	"item": [
		{
			"name": "1. Registrar cuenta tecnica (UNA sola vez)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
							"var body = pm.response.json();",
							"pm.environment.set('token', body.id_token);",
							"console.log('provisioningStatus:', body.integration.provisioningStatus);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"groupId\": \"{{groupId}}\",\n  \"firstName\": \"Candela\",\n  \"lastName\": \"Gonzalez\",\n  \"langKey\": \"es\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/student/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"student",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Login tecnico (CU-04)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
							"var body = pm.response.json();",
							"pm.environment.set('token', body.id_token);",
							"pm.test('integracion PROVISIONED', function () { pm.expect(body.integration.provisioningStatus).to.eql('PROVISIONED'); });"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/authenticate",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"authenticate"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Recuperar integracion vigente (CU-04)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/student/integration",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"student",
						"integration"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Snapshot del catalogo (CU-05)",
			"request": {
				"method": "GET",
